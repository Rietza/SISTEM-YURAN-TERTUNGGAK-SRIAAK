# SRIAAKL - Environment Variables
# Salin fail ini ke .env: cp .env.example .env
#
# ATAU jalankan setup.sh untuk konfigurasi automatik:
#   bash setup.sh sqlite    (untuk dev tempatan)
#   bash setup.sh supabase  (untuk production / Vercel)

# ============================================================
# UNTUK VERCEL (WAJIB PostgreSQL - SQLite TIDAK BERFUNGSI)
# ============================================================
# 1. Pergi ke: Vercel Dashboard → Project → Settings → Environment Variables
# 2. Tambah variable:
#    Key: DATABASE_URL
#    Value: (salin salah satu dari bawah)
#    Environment: Production, Preview, Development (tick semua)
# 3. Redeploy

# ============================================================
# PILIHAN A: Supabase Direct Connection
# ============================================================
# Dapatkan dari: Supabase Dashboard → Settings → Database → Connection string
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
#
# Contoh:
DATABASE_URL="postgresql://postgres:Riezamahmood1211@db.bcovngbahyygvlcgctoc.supabase.co:5432/postgres"

# ============================================================
# PILIHAN B: Supabase Pooler Connection (disyorkan jika direct blocked)
# ============================================================
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# Gantikan REGION dengan region sebenar project anda (check Supabase dashboard)
#
# Contoh untuk Singapore (ap-southeast-1):
# DATABASE_URL="postgresql://postgres.bcovngbahyygvlcgctoc:Riezamahmood1211@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ============================================================
# PILIHAN C: SQLite (DEV TEMPATAN SAHAJA - TIDAK UNTUK VERCEL)
# ============================================================
# Untuk dev tempatan sahaja. Vercel filesystem read-only, SQLite tidak berfungsi.
# Tukar schema ke SQLite dahulu: cp prisma/schema.sqlite.prisma prisma/schema.prisma
#
# DATABASE_URL="file:./db/custom.db"

# ============================================================
# Metadate Supabase (pilihan - untuk rujukan)
# ============================================================
# SUPABASE_URL="https://bcovngbahyygvlcgctoc.supabase.co"
# SUPABASE_PUBLISHABLE_KEY="sb_publishable_1g8R46p-vAYF87V-zrYbOw_e0paveSe"
# SUPABASE_PROJECT_REF="bcovngbahyygvlcgctoc"
