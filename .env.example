# SRIAAKL - Environment Variables
# Salin fail ini ke .env: cp .env.example .env
#
# ATAU jalankan setup.sh untuk konfigurasi automatik:
#   bash setup.sh sqlite    (default - paling mudah)
#   bash setup.sh supabase  (untuk Supabase PostgreSQL)

# ============================================================
# PILIHAN 1: SQLite (DEFAULT - untuk pembangunan tempatan)
# ============================================================
# Tiada konfigurasi tambahan diperlukan. Fail DB dicipta di db/custom.db
DATABASE_URL="file:./db/custom.db"

# ============================================================
# PILIHAN 2: Supabase PostgreSQL (untuk production / berkongsi data)
# ============================================================
# 1. Dapatkan connection string dari:
#    https://supabase.com/dashboard/project/[PROJECT_REF]/settings/database
#
# 2. Salin "Connection pooling" URL (format: postgresql://postgres.XXX:PASS@aws-0-REGION.pooler.supabase.com:5432/postgres)
#
# 3. Tukar DATABASE_URL di bawah dan padam baris SQLite di atas
#
# DATABASE_URL="postgresql://postgres.bcovngbahyygvlcgctoc:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
#
# 4. Tukar schema Prisma ke PostgreSQL:
#    cp prisma/schema.supabase.prisma prisma/schema.prisma
#
# 5. Push schema & jana data:
#    bun run db:push
#    bun run prisma/seed.ts

# ============================================================
# Metadate Supabase (pilihan - untuk rujukan)
# ============================================================
# SUPABASE_URL="https://PROJECT_REF.supabase.co"
# SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxx"
# SUPABASE_PROJECT_REF="xxxxxxxx"
